{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":prHourlyLimitNone"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "after 3am and before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps):",
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "vulnerabilityAlerts": {
    "addLabels": [
      "renovate/security"
    ]
  },
  "packageRules": [
    {
      "description": "Actions are SHA-pinned; non-major bumps merge on their own once checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates wait for a human",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "renovate/major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "renovate/minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "renovate/patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "renovate/digest"
      ]
    },
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "addLabels": [
        "renovate/pin"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Keep the gh-actions-lock version that verifies actions.lock in CI and the one Renovate regenerates it with in step",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/verify-lockfile\\.yaml$/",
        "/^\\.github/renovate\\.json$/"
      ],
      "matchStrings": [
        "gh extension install github/gh-actions-lock --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "\"ghActionsLock\": \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
